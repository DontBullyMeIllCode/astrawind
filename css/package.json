{
  "name": "@astrawind/css",
  "version": "0.3.0",
  "description": "Tailwind CSS v4 for React Native. className in, native styles out, resolved at runtime.",
  "keywords": [
    "tailwind",
    "tailwindcss",
    "react-native",
    "expo",
    "styling",
    "className",
    "css"
  ],
  "license": "MIT",
  "homepage": "https://www.astrawind.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DontBullyMeIllCode/astrawind.git",
    "directory": "css"
  },
  "bugs": {
    "url": "https://github.com/DontBullyMeIllCode/astrawind/issues"
  },
  "author": "Alexandra Smith",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "gen": "node scripts/gen-theme.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.78"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
