{
  "name": "@astrawind/ui",
  "version": "0.2.0",
  "description": "shadcn/ui for React Native. The same components, props and classes, styled with @astrawind/css.",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "react-native",
    "expo",
    "tailwind",
    "components",
    "ui"
  ],
  "license": "MIT",
  "author": "Alexandra Smith",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": {
      "react-native": "./src/components/*.tsx",
      "import": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.js"
      },
      "require": {
        "types": "./dist/components/*.d.cts",
        "default": "./dist/components/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "sync": "node scripts/sync-shadcn.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@astrawind/css": ">=0.2.0",
    "lucide-react-native": ">=1",
    "react": ">=19",
    "react-hook-form": ">=7",
    "react-native": ">=0.78",
    "react-native-safe-area-context": ">=4",
    "react-native-svg": ">=15"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    }
  },
  "dependencies": {
    "@rn-primitives/accordion": "^1.5.2",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/aspect-ratio": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/collapsible": "^1.5.2",
    "@rn-primitives/context-menu": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/hover-card": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/menubar": "^1.5.2",
    "@rn-primitives/navigation-menu": "^1.5.2",
    "@rn-primitives/popover": "^1.5.2",
    "@rn-primitives/portal": "^1.5.3",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@rn-primitives/toggle": "^1.5.2",
    "@rn-primitives/toggle-group": "^1.5.2",
    "@rn-primitives/tooltip": "^1.5.2",
    "@rn-primitives/types": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@astrawind/css": "workspace:^",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "lucide-react-native": "^1.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "react-native": "./src/index.ts"
}
